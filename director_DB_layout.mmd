erDiagram

    %% USER MANAGEMENT
    ROLE ||--o{ USER_ACCOUNT : assigned
    USER_ACCOUNT ||--o{ AUDIT_LOG : generates

    ROLE {
        string role_id PK
        string role_name
    }

    USER_ACCOUNT {
        string user_id PK
        string role_id FK
        string name
        string email
        string password_hash
    }

    %% HOSTEL MANAGEMENT
    HOSTEL ||--o{ BLOCK : contains
    BLOCK ||--o{ ROOM : contains
    ROOM ||--o{ STUDENT : accommodates

    HOSTEL {
        string hostel_id PK
        string name
        string code
    }

    BLOCK {
        string block_id PK
        string hostel_id FK
        string block_name
    }

    ROOM {
        string room_id PK
        string block_id FK
        string room_number
        int capacity
    }

    STUDENT {
        string student_id PK
        string enrollment_no UK
        string name
        string room_id FK
        string biometric_id
        string verification_status
    }

    %% ATTENDANCE AND LEAVE
    STUDENT ||--o{ ATTENDANCE_RECORD : has
    STUDENT ||--o{ LEAVE_RECORD : requests
    USER_ACCOUNT ||--o{ ATTENDANCE_RECORD : manages
    USER_ACCOUNT ||--o{ LEAVE_RECORD : approves

    ATTENDANCE_RECORD {
        string attendance_id PK
        string student_id FK
        string user_id FK
        date attendance_date
        string status
        time punch_time
        boolean is_defaulter
    }

    LEAVE_RECORD {
        string leave_id PK
        string student_id FK
        string user_id FK
        date start_date
        date end_date
        string reason
        string approval_status
        string gate_pass_no
    }

    %% DISCIPLINARY MANAGEMENT
    STUDENT ||--o{ VIOLATION_RECORD : commits
    VIOLATION_RECORD ||--o{ WARNING_TICKET : generates
    WARNING_TICKET ||--o{ DISCIPLINARY_ACTION : reviewed
    STUDENT ||--o{ TOKEN_HISTORY : receives

    VIOLATION_RECORD {
        string violation_id PK
        string student_id FK
        string violation_type
        date violation_date
        string description
    }

    WARNING_TICKET {
        string ticket_id PK
        string violation_id FK
        string warning_status
        date issue_date
    }

    DISCIPLINARY_ACTION {
        string action_id PK
        string ticket_id FK
        string user_id FK
        string action_taken
        date action_date
    }

    TOKEN_HISTORY {
        string token_id PK
        string student_id FK
        int tokens_received
        string reason
        date token_date
    }

    %% NOTIFICATION MANAGEMENT
    ALERT_TIER ||--o{ EMAIL_ALERT : defines
    STUDENT ||--o{ EMAIL_ALERT : receives
    EMAIL_ALERT ||--o{ NOTIFICATION_LOG : tracks

    ALERT_TIER {
        string tier_id PK
        string tier_name
        int threshold
    }

    EMAIL_ALERT {
        string alert_id PK
        string student_id FK
        string tier_id FK
        string alert_status
        date sent_date
    }

    NOTIFICATION_LOG {
        string log_id PK
        string alert_id FK
        string delivery_status
        date sent_at
    }

    %% AUTOMATED REPORTING
    SCHEDULED_JOB ||--o{ JOB_EXECUTION_LOG : executes
    JOB_EXECUTION_LOG ||--o{ JOB_EVALUATION_RESULT : produces

    SCHEDULED_JOB {
        string job_id PK
        string job_name
        string schedule
        boolean is_active
    }

    JOB_EXECUTION_LOG {
        string execution_id PK
        string job_id FK
        date execution_date
        string status
    }

    JOB_EVALUATION_RESULT {
        string result_id PK
        string execution_id FK
        string result_status
    }

    %% SECURITY AND AUDIT
    USER_ACCOUNT ||--o{ AUDIT_LOG : creates

    AUDIT_LOG {
        string audit_id PK
        string user_id FK
        string activity
        date activity_date
    }
